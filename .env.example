# Copie este arquivo para .env e preencha os valores. O .env nao vai para o Git.
# Para o deploy no Azure, pode criar uma copia .env.azure com os valores de producao (tambem fora do Git).

# Banco Oracle
DB_URL=jdbc:oracle:thin:@HOST:1521:SID
DB_USERNAME=
DB_PASSWORD=

# JWT_SECRET: minimo de 32 caracteres (HS256)
JWT_SECRET=

# Spring AI (OpenAI). O SDK usado pelo Spring AI 2.x espera a URL com /v1.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# RabbitMQ
# Local (docker compose): os valores abaixo.
# CloudAMQP: host da instancia, porta 5671, usuario e senha da instancia,
# vhost da instancia (em geral igual ao usuario) e RABBITMQ_SSL=true.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VIRTUAL_HOST=/
RABBITMQ_SSL=false

# Servico de risco de falta (vaga-certa-ia). Localmente: RISCO_FALTA_URL=http://localhost:8000
# Vazio = stub (risco e nivel null). Se o servico estiver fora do ar, a API continua respondendo com risco null.
RISCO_FALTA_URL=
# Enviado no header X-Service-Token, so se preenchido (precisa ser o mesmo configurado no servico)
RISCO_FALTA_TOKEN=
RISCO_FALTA_CONNECT_TIMEOUT_MS=3000
RISCO_FALTA_READ_TIMEOUT_MS=15000
