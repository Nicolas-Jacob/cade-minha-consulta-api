# Copie este arquivo para .env e preencha os valores. O .env nao vai para o Git.

# Banco Oracle
DB_URL=jdbc:oracle:thin:@HOST:1521:SID
DB_USERNAME=
DB_PASSWORD=

# JWT_SECRET: minimo de 32 caracteres (HS256)
JWT_SECRET=

# Spring AI (OpenAI). O SDK usado pelo Spring AI 2.x espera a URL com /v1.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# URL do serviço do modelo de risco de falta. Vazio = stub (risco null)
RISCO_FALTA_URL=
