### Testes manuais da API (extensao REST Client do VS Code)
@baseUrl = http://localhost:8080

### Health (publico)
GET {{baseUrl}}/actuator/health

### Login do gestor (carga de dados)
# @name loginGestor
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "login": "gestor",
  "senha": "SenhaGestor2026"
}

### Login do cidadao de teste (carga de dados)
# @name loginCidadao
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "login": "cidadao",
  "senha": "Senha123"
}

### Login com senha errada (401)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "login": "gestor",
  "senha": "errada"
}

### Cadastro de cidadao (201). Troque cpf e login para rodar de novo (senao 409).
# @name register
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "nome": "Maria",
  "sobrenome": "Teste da Silva",
  "cpf": "12345678901",
  "sexo": "F",
  "dataNascimento": "1990-05-10",
  "nomeMae": "Ana da Silva",
  "nomePai": "Jose da Silva",
  "login": "maria.teste",
  "senha": "Senha123",
  "telefone": "11987654321",
  "email": "maria.teste@email.com",
  "endereco": {
    "cep": "01310100",
    "logradouro": "Avenida Paulista",
    "numero": 1000,
    "complemento": "Apto 12",
    "bairro": "Bela Vista",
    "cidade": "Sao Paulo",
    "uf": "SP"
  }
}

### Cadastro invalido (400 com "campos")
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "nome": "",
  "cpf": "123",
  "sexo": "X",
  "login": "x",
  "senha": "1",
  "telefone": "1",
  "endereco": { "cep": "1", "uf": "XX", "numero": 0 }
}

### Meus dados com o token do gestor
GET {{baseUrl}}/api/usuarios/me
Authorization: Bearer {{loginGestor.response.body.token}}

### Meus dados com o token do cidadao
GET {{baseUrl}}/api/usuarios/me
Authorization: Bearer {{loginCidadao.response.body.token}}

### Atualizar meus dados (cidadao)
PUT {{baseUrl}}/api/usuarios/me
Authorization: Bearer {{loginCidadao.response.body.token}}
Content-Type: application/json

{
  "nome": "Cidadao",
  "sobrenome": "Atualizado",
  "telefone": "11912345678",
  "email": "cidadao@email.com",
  "endereco": {
    "cep": "01001000",
    "logradouro": "Praca da Se",
    "numero": 1,
    "complemento": null,
    "bairro": "Se",
    "cidade": "Sao Paulo",
    "uf": "SP"
  }
}

### Sem token (401)
GET {{baseUrl}}/api/usuarios/me

# =====================================================================
# CATALOGO: ESPECIALIDADES
# Rode antes o loginGestor e o loginCidadao (la em cima).
# =====================================================================

### Listar especialidades (paginado; padrao size=10, sort=nome,asc)
GET {{baseUrl}}/api/especialidades?page=0&size=5&sort=nome,asc
Authorization: Bearer {{loginCidadao.response.body.token}}

### Buscar especialidade por id
GET {{baseUrl}}/api/especialidades/1
Authorization: Bearer {{loginCidadao.response.body.token}}

### Criar especialidade (GESTOR, 201)
# @name criarEspecialidade
POST {{baseUrl}}/api/especialidades
Authorization: Bearer {{loginGestor.response.body.token}}
Content-Type: application/json

{
  "nome": "Especialidade Teste",
  "descricao": "Criada pelo test.http"
}

### Atualizar especialidade (GESTOR)
PUT {{baseUrl}}/api/especialidades/{{criarEspecialidade.response.body.id}}
Authorization: Bearer {{loginGestor.response.body.token}}
Content-Type: application/json

{
  "nome": "Especialidade Teste 2",
  "descricao": "Editada pelo test.http"
}

### Excluir especialidade criada acima (GESTOR, 204)
DELETE {{baseUrl}}/api/especialidades/{{criarEspecialidade.response.body.id}}
Authorization: Bearer {{loginGestor.response.body.token}}

### Excluir especialidade em uso por medico ou fila (409)
DELETE {{baseUrl}}/api/especialidades/1
Authorization: Bearer {{loginGestor.response.body.token}}

### Cidadao tentando criar especialidade (403)
POST {{baseUrl}}/api/especialidades
Authorization: Bearer {{loginCidadao.response.body.token}}
Content-Type: application/json

{
  "nome": "Nao pode",
  "descricao": "Cidadao nao e gestor"
}

### Ordenacao por campo inexistente (400)
GET {{baseUrl}}/api/especialidades?sort=xpto
Authorization: Bearer {{loginCidadao.response.body.token}}

# =====================================================================
# CATALOGO: UNIDADES
# =====================================================================

### Listar unidades como cidadao (so ATIVO; o filtro status e ignorado)
GET {{baseUrl}}/api/unidades
Authorization: Bearer {{loginCidadao.response.body.token}}

### Unidades com medico ATIVO da especialidade 1
GET {{baseUrl}}/api/unidades?especialidade=1
Authorization: Bearer {{loginCidadao.response.body.token}}

### Listar unidades como gestor, filtrando por status
GET {{baseUrl}}/api/unidades?status=INATIVO
Authorization: Bearer {{loginGestor.response.body.token}}

### Buscar unidade por id
GET {{baseUrl}}/api/unidades/1
Authorization: Bearer {{loginCidadao.response.body.token}}

### Criar unidade com contato e endereco (GESTOR, 201; status opcional, padrao ATIVO)
# @name criarUnidade
POST {{baseUrl}}/api/unidades
Authorization: Bearer {{loginGestor.response.body.token}}
Content-Type: application/json

{
  "nome": "Unidade Teste",
  "telefone": "1133334444",
  "email": "unidade.teste@saude.com",
  "endereco": {
    "cep": "01310100",
    "logradouro": "Avenida Paulista",
    "numero": 2000,
    "complemento": null,
    "bairro": "Bela Vista",
    "cidade": "Sao Paulo",
    "uf": "SP"
  }
}

### Atualizar unidade, contato e endereco (GESTOR)
PUT {{baseUrl}}/api/unidades/{{criarUnidade.response.body.id}}
Authorization: Bearer {{loginGestor.response.body.token}}
Content-Type: application/json

{
  "nome": "Unidade Teste Editada",
  "telefone": "11999998888",
  "email": null,
  "endereco": {
    "cep": "01001000",
    "logradouro": "Praca da Se",
    "numero": 10,
    "complemento": "Sala 2",
    "bairro": "Se",
    "cidade": "Sao Paulo",
    "uf": "SP"
  }
}

### Inativar unidade (GESTOR, 204)
DELETE {{baseUrl}}/api/unidades/{{criarUnidade.response.body.id}}
Authorization: Bearer {{loginGestor.response.body.token}}

### Cidadao buscando unidade INATIVO (404)
GET {{baseUrl}}/api/unidades/{{criarUnidade.response.body.id}}
Authorization: Bearer {{loginCidadao.response.body.token}}

### Reativar unidade pelo PUT com status (GESTOR)
PUT {{baseUrl}}/api/unidades/{{criarUnidade.response.body.id}}
Authorization: Bearer {{loginGestor.response.body.token}}
Content-Type: application/json

{
  "nome": "Unidade Teste Editada",
  "telefone": "11999998888",
  "endereco": {
    "cep": "01001000",
    "logradouro": "Praca da Se",
    "numero": 10,
    "bairro": "Se",
    "cidade": "Sao Paulo",
    "uf": "SP"
  },
  "status": "ATIVO"
}

# =====================================================================
# CATALOGO: MEDICOS (so GESTOR)
# =====================================================================

### Listar medicos com filtros opcionais
GET {{baseUrl}}/api/medicos?especialidade=1&unidade=1
Authorization: Bearer {{loginGestor.response.body.token}}

### Buscar medico por id
GET {{baseUrl}}/api/medicos/1
Authorization: Bearer {{loginGestor.response.body.token}}

### Criar medico (201). Troque o CRM para rodar de novo (senao 409).
# @name criarMedico
POST {{baseUrl}}/api/medicos
Authorization: Bearer {{loginGestor.response.body.token}}
Content-Type: application/json

{
  "nome": "Paula",
  "sobrenome": "Teste",
  "crm": "CRM0000001",
  "ufCrm": "SP",
  "idsEspecialidades": [1, 2],
  "idsUnidades": [1]
}

### Mesmo CRM na mesma UF (409)
POST {{baseUrl}}/api/medicos
Authorization: Bearer {{loginGestor.response.body.token}}
Content-Type: application/json

{
  "nome": "Outro",
  "sobrenome": "Medico",
  "crm": "CRM0000001",
  "ufCrm": "SP",
  "idsEspecialidades": [1],
  "idsUnidades": [1]
}

### Especialidade inexistente (404)
POST {{baseUrl}}/api/medicos
Authorization: Bearer {{loginGestor.response.body.token}}
Content-Type: application/json

{
  "nome": "Outro",
  "sobrenome": "Medico",
  "crm": "CRM0000002",
  "ufCrm": "SP",
  "idsEspecialidades": [999999],
  "idsUnidades": [1]
}

### Atualizar medico, especialidades e unidades
PUT {{baseUrl}}/api/medicos/{{criarMedico.response.body.id}}
Authorization: Bearer {{loginGestor.response.body.token}}
Content-Type: application/json

{
  "nome": "Paula",
  "sobrenome": "Teste Editada",
  "crm": "CRM0000001",
  "ufCrm": "SP",
  "idsEspecialidades": [3],
  "idsUnidades": [1, 2]
}

### Inativar medico (204)
DELETE {{baseUrl}}/api/medicos/{{criarMedico.response.body.id}}
Authorization: Bearer {{loginGestor.response.body.token}}

### Cidadao listando medicos (403)
GET {{baseUrl}}/api/medicos
Authorization: Bearer {{loginCidadao.response.body.token}}

# =====================================================================
# FILAS (solicitacoes de consulta)
# =====================================================================

### Criar solicitacao (CIDADAO, 201): prioridade 1, AGUARDANDO
# @name criarFila
POST {{baseUrl}}/api/filas
Authorization: Bearer {{loginCidadao.response.body.token}}
Content-Type: application/json

{
  "idEspecialidade": 3,
  "idUnidade": 3
}

### Mesma especialidade de novo enquanto AGUARDANDO (409)
POST {{baseUrl}}/api/filas
Authorization: Bearer {{loginCidadao.response.body.token}}
Content-Type: application/json

{
  "idEspecialidade": 3,
  "idUnidade": 1
}

### Especialidade inexistente (404)
POST {{baseUrl}}/api/filas
Authorization: Bearer {{loginCidadao.response.body.token}}
Content-Type: application/json

{
  "idEspecialidade": 999999,
  "idUnidade": 1
}

### Minhas solicitacoes (CIDADAO; posicaoEstimada so nas AGUARDANDO)
GET {{baseUrl}}/api/filas/minhas
Authorization: Bearer {{loginCidadao.response.body.token}}

### Buscar a solicitacao (dono)
GET {{baseUrl}}/api/filas/{{criarFila.response.body.id}}
Authorization: Bearer {{loginCidadao.response.body.token}}

### Buscar a solicitacao (GESTOR)
GET {{baseUrl}}/api/filas/{{criarFila.response.body.id}}
Authorization: Bearer {{loginGestor.response.body.token}}

### Trocar a unidade (dono; so AGUARDANDO)
PUT {{baseUrl}}/api/filas/{{criarFila.response.body.id}}
Authorization: Bearer {{loginCidadao.response.body.token}}
Content-Type: application/json

{
  "idUnidade": 1
}

### Alterar prioridade (GESTOR, 1 a 5)
PATCH {{baseUrl}}/api/filas/{{criarFila.response.body.id}}/prioridade
Authorization: Bearer {{loginGestor.response.body.token}}
Content-Type: application/json

{
  "prioridade": 4
}

### Prioridade fora da faixa (400)
PATCH {{baseUrl}}/api/filas/{{criarFila.response.body.id}}/prioridade
Authorization: Bearer {{loginGestor.response.body.token}}
Content-Type: application/json

{
  "prioridade": 9
}

### Desistir (dono, 204): status CANCELADA + data_saida
DELETE {{baseUrl}}/api/filas/{{criarFila.response.body.id}}
Authorization: Bearer {{loginCidadao.response.body.token}}

### Desistir de novo (409: nao esta mais AGUARDANDO)
DELETE {{baseUrl}}/api/filas/{{criarFila.response.body.id}}
Authorization: Bearer {{loginCidadao.response.body.token}}

### Listar filas com filtros (GESTOR; padrao prioridade,desc e dataEntrada,asc)
GET {{baseUrl}}/api/filas?status=AGUARDANDO&especialidade=3&unidade=3
Authorization: Bearer {{loginGestor.response.body.token}}

### Cidadao listando todas as filas (403)
GET {{baseUrl}}/api/filas
Authorization: Bearer {{loginCidadao.response.body.token}}

# =====================================================================
# CONSULTAS (cidadao)
# A consulta futura do usuario "cidadao" e usada no app mobile: NAO confirme nem cancele.
# Para confirmar/cancelar, use outro cidadao da carga com consulta futura AGENDADA
# (senha = Senha + numero do usuario com 4 digitos, ex.: Senha0002) e preencha as variaveis abaixo.
# =====================================================================
@outroLogin = TROCAR_LOGIN
@outroSenha = TROCAR_SENHA
@idConsultaOutro = 0

### Login do outro cidadao (dono da consulta usada nos testes de confirmar/cancelar)
# @name loginOutro
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "login": "{{outroLogin}}",
  "senha": "{{outroSenha}}"
}

### Minhas consultas futuras (padrao; dataHora,asc)
# @name minhasFuturas
GET {{baseUrl}}/api/consultas/minhas
Authorization: Bearer {{loginCidadao.response.body.token}}

### Meu historico (dataHora,desc)
GET {{baseUrl}}/api/consultas/minhas?periodo=historico&page=0&size=5
Authorization: Bearer {{loginCidadao.response.body.token}}

### Periodo invalido (400)
GET {{baseUrl}}/api/consultas/minhas?periodo=xpto
Authorization: Bearer {{loginCidadao.response.body.token}}

### Buscar a primeira consulta futura (dono; sem "paciente")
GET {{baseUrl}}/api/consultas/{{minhasFuturas.response.body.content[0].id}}
Authorization: Bearer {{loginCidadao.response.body.token}}

### Buscar a mesma consulta como GESTOR (com "paciente")
GET {{baseUrl}}/api/consultas/{{minhasFuturas.response.body.content[0].id}}
Authorization: Bearer {{loginGestor.response.body.token}}

### Consulta de outro cidadao (403)
GET {{baseUrl}}/api/consultas/{{idConsultaOutro}}
Authorization: Bearer {{loginCidadao.response.body.token}}

### Consulta inexistente (404)
GET {{baseUrl}}/api/consultas/999999
Authorization: Bearer {{loginCidadao.response.body.token}}

### Confirmar (outro cidadao): AGENDADA -> CONFIRMADA
PATCH {{baseUrl}}/api/consultas/{{idConsultaOutro}}/confirmar
Authorization: Bearer {{loginOutro.response.body.token}}

### Confirmar de novo (409: ja esta CONFIRMADA)
PATCH {{baseUrl}}/api/consultas/{{idConsultaOutro}}/confirmar
Authorization: Bearer {{loginOutro.response.body.token}}

### Cancelar (outro cidadao): CANCELADA, fila CANCELADA e evento vaga.liberada no RabbitMQ
PATCH {{baseUrl}}/api/consultas/{{idConsultaOutro}}/cancelar
Authorization: Bearer {{loginOutro.response.body.token}}

### Cancelar de novo (409)
PATCH {{baseUrl}}/api/consultas/{{idConsultaOutro}}/cancelar
Authorization: Bearer {{loginOutro.response.body.token}}

### Gestor tentando confirmar (403: rota so do CIDADAO)
PATCH {{baseUrl}}/api/consultas/{{idConsultaOutro}}/confirmar
Authorization: Bearer {{loginGestor.response.body.token}}

# =====================================================================
# GESTOR: agendamento, proximas consultas e presenca
# =====================================================================
@idMedicoComFila = 1

### Agendar o proximo da fila do medico (201; PRC_AGENDAR_CONSULTA)
# @name agendamento
POST {{baseUrl}}/api/gestor/agendamentos
Authorization: Bearer {{loginGestor.response.body.token}}
Content-Type: application/json

{
  "idMedico": {{idMedicoComFila}}
}

### Medico inexistente (404, erro -20001 da procedure)
POST {{baseUrl}}/api/gestor/agendamentos
Authorization: Bearer {{loginGestor.response.body.token}}
Content-Type: application/json

{
  "idMedico": 999999
}

### Sem idMedico (400 com "campos")
POST {{baseUrl}}/api/gestor/agendamentos
Authorization: Bearer {{loginGestor.response.body.token}}
Content-Type: application/json

{}

### Proximas consultas nos proximos 15 dias (dataHora,asc; com paciente)
GET {{baseUrl}}/api/gestor/consultas/proximas?dias=15
Authorization: Bearer {{loginGestor.response.body.token}}

### dias invalido (400)
GET {{baseUrl}}/api/gestor/consultas/proximas?dias=0
Authorization: Bearer {{loginGestor.response.body.token}}

### Presenca em consulta futura (409: so depois da data)
PATCH {{baseUrl}}/api/gestor/consultas/{{agendamento.response.body.id}}/presenca
Authorization: Bearer {{loginGestor.response.body.token}}
Content-Type: application/json

{
  "status": "PRESENTE"
}

### Status de presenca invalido (400)
PATCH {{baseUrl}}/api/gestor/consultas/{{agendamento.response.body.id}}/presenca
Authorization: Bearer {{loginGestor.response.body.token}}
Content-Type: application/json

{
  "status": "CANCELADA"
}

### Cidadao acessando rota do gestor (403)
GET {{baseUrl}}/api/gestor/consultas/proximas
Authorization: Bearer {{loginCidadao.response.body.token}}
